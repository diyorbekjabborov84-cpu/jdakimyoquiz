# Telegram Bot Token (@BotFather orqali olingan token)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Server porti (Render avtomatik tarzda PORT beradi, default: 3000)
PORT=3000

# Ishlash muhiti (development yoki production)
NODE_ENV=development

# Webhook sozlamalari (Render yoki production HTTPS webhook uchun, ixtiyoriy)
WEBHOOK_URL=
WEBHOOK_SECRET=

# Firebase Cloud Firestore sozlamalari (production sessiyalarini doimiy saqlash uchun)
# 1. Lokal muhitda: Service account JSON satri yoki uning fayl yo'li
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
# Lokal bot sessiyalarini Firestore'da saqlash faqat ataylab yoqilganda ishlaydi.
# Oddiy testlar haqiqiy quiz_sessions kolleksiyasiga yozib yubormasligi uchun default false.
FIRESTORE_LOCAL_ENABLED=false
# 2. Render muhitida: Secret Files orqali /etc/secrets/firebase-service-account.json o'rnatiladi

# Tashqi PostgreSQL ulanishi (ixtiyoriy / qo'shimcha)
DATABASE_URL=
